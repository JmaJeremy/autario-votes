    flex-wrap: wrap;
  }

  .jump-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-light);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .race-jump-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

