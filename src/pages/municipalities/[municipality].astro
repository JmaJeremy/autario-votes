    font-size: 1.15rem;
    color: var(--text-light);
    max-width: 850px;
    line-height: 1.6;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-bottom: 3rem;
  }

