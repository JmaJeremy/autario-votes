---
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Your trusted source for local election information" } = Astro.props;
---

<!doctype html>
<html lang="en" data-election-view="municipal">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      // Initialize election view from localStorage or URL query parameter
      (function() {
        const urlParams = new URLSearchParams(window.location.search);
        const queryView = urlParams.get('election');
        const validViews = ['provincial', 'municipal'];
        let view = 'municipal'; // Default to municipal elections view
        
        if (queryView && validViews.includes(queryView)) {
          view = queryView;
          try { localStorage.setItem('autario_election_view', view); } catch (e) {}
        } else {
          try {
            const saved = localStorage.getItem('autario_election_view');
            if (saved && validViews.includes(saved)) {
              view = saved;
            }
          } catch (e) {}
        }
        
        document.documentElement.setAttribute('data-election-view', view);
      })();
    </script>
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        /* Non-partisan civic palette */
        --primary: #1e293b;        /* Authoritative Neutral Slate */
        --primary-dark: #0f172a;   /* Deep Slate */
        --secondary: #0f766e;      /* Civic Teal */
        --secondary-dark: #115e59;
        --accent: #0f766e;         /* Neutral Civic Accent */
        --text: #1f2937;
        --text-light: #4b5563;
        --border: #e2e8f0;
        --bg: #ffffff;
        --bg-alt: #f8fafc;
        --civic-badge: #334155;    /* Slate badge */
        --civic-tag-bg: #f1f5f9;
        --civic-tag-text: #334155;
        --civic-tag-border: #cbd5e1;
        /* Neutralized variables to eliminate partisan bias */
        --pc-blue: #334155;
        --lib-red: #64748b;
        --ndp-orange: #94a3b8;
        --green-party: #475569;
        --new-blue: #1e293b;
        --success: #15803d;
        --success-bg: #dcfce7;
      }

      /* Dynamic election view switcher visibility - default is municipal */
      html[data-election-view="provincial"] .municipal-only {
        display: none !important;
      }

      html[data-election-view="municipal"] .provincial-only,
      html:not([data-election-view="provincial"]) .provincial-only {
        display: none !important;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
        line-height: 1.6;
        color: var(--text);
        background: var(--bg);
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      a {
        color: var(--primary);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      a:focus {
        outline: 2px solid var(--primary);
        outline-offset: 2px;
      }

      .page-content {
        padding: 3rem 0;
        max-width: 900px;
      }

      .page-content h1 {
        font-size: 2.5rem;
        margin-bottom: 2rem;
        color: var(--primary);
      }

      .page-content section {
        margin-bottom: 3rem;
      }

      .page-content h2 {
        font-size: 1.75rem;
        margin-bottom: 1rem;
        color: var(--text);
      }

      .page-content h3 {
        font-size: 1.25rem;
        margin-bottom: 0.5rem;
        color: var(--primary);
      }

      .page-content p,
      .page-content ul {
        margin-bottom: 1rem;
        font-size: 1.05rem;
      }

      .page-content ul {
        padding-left: 2rem;
      }

      .page-content li {
        margin-bottom: 0.5rem;
      }

      .link-button {
        display: inline-block;
        background: var(--primary);
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 0.375rem;
        font-weight: 600;
        margin-top: 1rem;
        transition: background 0.2s;
      }

      .link-button:hover {
        background: var(--primary-dark);
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <footer>
      <div class="container">
        <p><a href="https://autvotes.ca/">Autario Votes - Simcoe County</a> © {new Date().getFullYear()} by <a href="https://sadc-sz.ca/" target="_blank">Simcoelandic Autarian Development Corporation</a> 
            is licensed under <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a>
            <img src="https://mirrors.creativecommons.org/presskit/icons/cc.svg" alt="" style="max-width: 1em;max-height:1em;margin-left: .2em;">
            <img src="https://mirrors.creativecommons.org/presskit/icons/by.svg" alt="" style="max-width: 1em;max-height:1em;margin-left: .2em;">
            <img src="https://mirrors.creativecommons.org/presskit/icons/nc.svg" alt="" style="max-width: 1em;max-height:1em;margin-left: .2em;">
            <img src="https://mirrors.creativecommons.org/presskit/icons/sa.svg" alt="" style="max-width: 1em;max-height:1em;margin-left: .2em;">
        </p>
        <p>Non-partisan voter resource.</p>
        <p>
          <a href="https://github.com/JmaJeremy/autario-votes" target="_blank">Contribute on GitHub</a>
        </p>
      </div>
    </footer>
    <style>
      footer {
        margin-top: 4rem;
        padding: 2rem 0;
        background: var(--bg-alt);
        border-top: 1px solid var(--border);
        text-align: center;
        color: var(--text-light);
      }

      footer p {
        margin: 0.25rem 0;
      }
    </style>
  </body>
</html>